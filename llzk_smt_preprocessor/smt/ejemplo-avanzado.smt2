(set-logic ALL)
(set-info :source "demo yaspar")
(declare-datatype Color ((red) (green) (blue)))
(declare-datatypes ((List 1)) ((par (T) ((nil) (cons (head T) (tail (List T)))))))
(declare-fun f (Int Int) Bool)
(define-fun double ((n Int)) Int (* 2 n))
(declare-const c Color)
(assert (forall ((x Int)) (=> (> x 0) (f x (double x)))))
(assert (let ((a (+ 1 2))) (> a 0)))
(assert (! (= c red) :named eq_red))
(push 1)
(check-sat)
(pop 1)
(exit)
